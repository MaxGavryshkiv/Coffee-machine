// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

enum UnitType {
  GRAM
  ML
  PIECE
}

enum Currency {
  UAH
  USD
  EUR
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MovementType {
  IN
  OUT
  WASTE
  ADJUSTMENT
}

enum Role {
  OWNER
  MANAGER
  SELLER
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// === TENANT ===
model Tenant {
  id   String @id @default(uuid())
  name String

  users       User[]
  products    Product[]
  ingredients Ingredient[]
  recipes     Recipe[]
  suppliers   Supplier[]

  locations Location[]
  createdAt DateTime   @default(now())
}

// === LOCATION ===
model Location {
  id       String  @id @default(uuid())
  name     String
  address  String?
  photoUrl String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  users     User[]
  stocks    Stock[]
  orders    Order[]
  purchases Purchase[]

  createdAt      DateTime        @default(now())
  deletedAt      DateTime?
  stockMovements StockMovement[]
  payments       Payment[]
  userLocations  UserLocation[]

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
}

model UserLocation {
  id         String @id @default(uuid())
  userId     String
  locationId String

  user     User     @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  assignedAt DateTime @default(now())

  @@unique([userId, locationId])
  @@index([locationId])
}

// === USER ===
model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  role     Role

  orders         Order[]
  stockMovements StockMovement[]
  userLocations  UserLocation[]

  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String
  location   Location? @relation(fields: [locationId], references: [id])
  locationId String?

  @@unique([tenantId, email])
  @@index([tenantId, deletedAt])
}

// === INGREDIENT ===
model Ingredient {
  id       String   @id @default(uuid())
  name     String
  unit     UnitType
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  recipeItems   RecipeItem[]
  stock         Stock[]
  movements     StockMovement[]
  purchaseItems PurchaseItem[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
}

// === STOCK ===
model Stock {
  id           String  @id @default(uuid())
  ingredientId String
  locationId   String
  quantity     Decimal @db.Decimal(12, 3)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  location   Location   @relation(fields: [locationId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([locationId, ingredientId])
  @@index([locationId])
}

// === STOCK MOVEMENT ===
model StockMovement {
  id           String  @id @default(uuid())
  ingredientId String
  locationId   String
  userId       String?

  type     MovementType
  quantity Decimal      @db.Decimal(12, 3)

  referenceId String?
  note        String?

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  location   Location   @relation(fields: [locationId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([locationId])
  @@index([ingredientId])
}

// === PRODUCT ===
model Product {
  id       String   @id @default(uuid())
  name     String
  price    Decimal  @db.Decimal(10, 2)
  currency Currency
  recipeId String?  @unique
  recipe   Recipe?  @relation(fields: [recipeId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
}

// === RECIPE ===
model Recipe {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  version   Int
  isActive  Boolean  @default(true)
  productId String?
  product   Product?

  items RecipeItem[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([tenantId, deletedAt])
}

// === RECIPE ITEM ===
model RecipeItem {
  id           String  @id @default(uuid())
  recipeId     String
  ingredientId String
  quantity     Decimal @db.Decimal(12, 3)

  recipe     Recipe     @relation(fields: [recipeId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
}

// === ORDER ===
model Order {
  id         String @id @default(uuid())
  locationId String
  userId     String

  status   OrderStatus
  total    Decimal     @db.Decimal(10, 2)
  currency Currency

  location Location    @relation(fields: [locationId], references: [id])
  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([locationId, deletedAt])
}

// === ORDER ITEM ===
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  recipeId  String?
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// === PAYMENT ===
model Payment {
  id       String        @id @default(uuid())
  orderId  String
  amount   Decimal       @db.Decimal(10, 2)
  currency Currency
  method   PaymentMethod
  status   PaymentStatus

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  order     Order     @relation(fields: [orderId], references: [id])

  @@index([locationId])
}

// === SUPPLIER ===
model Supplier {
  id       String  @id @default(uuid())
  name     String
  phone    String?
  email    String?
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  purchases Purchase[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
}

// === PURCHASE ===
model Purchase {
  id         String         @id @default(uuid())
  locationId String
  supplierId String
  status     PurchaseStatus
  total      Decimal        @db.Decimal(12, 2)

  location Location       @relation(fields: [locationId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([locationId, deletedAt])
}

// === PURCHASE ITEM ===
model PurchaseItem {
  id           String  @id @default(uuid())
  purchaseId   String
  ingredientId String
  quantity     Decimal @db.Decimal(12, 3)
  price        Decimal @db.Decimal(12, 2)

  purchase   Purchase   @relation(fields: [purchaseId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}
